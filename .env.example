# WebCheck AI Environment Configuration

# Database: SQLite for instant local runs (default), or PostgreSQL connection string
DATABASE_URL="file:./dev.db"

# Optional Redis connection for BullMQ async queue (fallback to internal async queue if unset)
# REDIS_URL="redis://localhost:6379"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Scanner Security Limits
MAX_REDIRECTS=5
FETCH_TIMEOUT_MS=10000
MAX_CONTENT_LENGTH_BYTES=10485760

